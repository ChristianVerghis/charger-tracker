{
  "name": "charger-tracker",
  "version": "0.0.1",
  "private": true,
  "description": "Hamilton/GTA EV charger reliability and insight tracker — see ../EV-Network/02_credibility_builds/project_01_charger_tracker/spec.md",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "ingest:ocm": "tsx scripts/ingest-ocm.ts",
    "fetch:ocm-reference": "tsx scripts/fetch-ocm-reference.ts",
    "upsert:ocm": "tsx scripts/upsert-from-ocm.ts",
    "seed:ev-models": "tsx scripts/seed-ev-models.ts",
    "prepare:prototype": "tsx scripts/prepare-prototype.ts",
    "prepare:web": "tsx scripts/prepare-web-snapshot.ts",
    "diff:snapshots": "tsx scripts/diff-snapshots.ts",
    "dev:prototype": "tsx scripts/prepare-prototype.ts && serve prototype -l 5173",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.9.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "serve": "^14.2.4",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "@tanstack/react-query": "^5.62.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "dotenv": "^16.4.7",
    "maplibre-gl": "^5.24.0",
    "next": "^16.2.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^3.24.1"
  }
}
