# Open Charge Map API key
# Register at: https://openchargemap.org/site/profile/applications
# Copy this file to `.env.local` and fill in real values.
OCM_API_KEY=

# Supabase
# Find these in your Supabase project: Settings → API
# - SUPABASE_URL: the project URL (e.g. https://xxxx.supabase.co)
# - SUPABASE_ANON_KEY: public anon key — safe to expose in browser code
# - SUPABASE_SERVICE_ROLE_KEY: server-only secret — bypasses RLS; never ship to browser
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
